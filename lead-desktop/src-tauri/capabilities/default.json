{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the main Studio window — minimum-privilege per release-audit P0-5/7",
  "windows": ["main"],
  "permissions": [
    "core:default",

    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",

    "fs:default",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$APPDATA/CW-Leaders-Studio/**" },
        { "path": "$APPLOCALDATA/CW-Leaders-Studio/**" },
        { "path": "$HOME/CW-Leaders-Recordings/**" },
        { "path": "$DOWNLOAD/**" }
      ]
    },

    "http:default",

    "os:default",
    "os:allow-os-type",
    "os:allow-version",
    "os:allow-arch",
    "os:allow-locale",

    "shell:default",
    "shell:allow-open",

    "updater:default",
    "updater:allow-check",
    "updater:allow-download",
    "updater:allow-install"
  ]
}
